<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 入口文件为 admin.html（构建时将 index.html 改名），IIS 默认文档需显式声明，
         否则访问目录 /cheng/ 返回 403 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="admin.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
